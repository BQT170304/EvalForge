# =============================================================================
# EvalForge — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Core Service ---
EVALFORGE_ENV=development
EVALFORGE_DEBUG=true
EVALFORGE_API_HOST=0.0.0.0
EVALFORGE_API_PORT=8080
EVALFORGE_API_KEY=your-api-key-here

# --- Database ---
EVALFORGE_DATABASE_URL=postgresql+asyncpg://evalforge:evalforge@localhost:5432/evalforge

# --- Redis ---
EVALFORGE_REDIS_URL=redis://localhost:6379/0

# --- LLM Providers (via LiteLLM) ---
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# OLLAMA_BASE_URL=http://localhost:11434

# --- Default Judge Model ---
EVALFORGE_JUDGE_MODEL=gpt-4o

# --- Embedding Model ---
EVALFORGE_EMBEDDING_MODEL=text-embedding-3-small
# For local embeddings, use: all-MiniLM-L6-v2

# --- Monitoring Service Adapters ---
# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Arize
ARIZE_API_KEY=
ARIZE_SPACE_KEY=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=evalforge

# Grafana Cloud (free tier) — see docs/observability-setup.md for how to get these
EVALFORGE_GRAFANA_OTLP_ENDPOINT=
EVALFORGE_GRAFANA_OTLP_INSTANCE_ID=
EVALFORGE_GRAFANA_OTLP_API_KEY=
